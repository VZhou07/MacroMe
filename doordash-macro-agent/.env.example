# ── Required for live DoorDash ordering ──────────────────────────────────────
STEEL_API_KEY=your_steel_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Set by `npm run setup-profile` after you log into DoorDash by hand once in
# the live browser view. The profile then carries that login into every
# scheduled run.
STEEL_PROFILE_ID=

# ── Optional: which model picks meals (OpenRouter id) ────────────────────────
# Default is a free model. For Claude via OpenRouter (needs credits on the key):
# MACROME_MODEL=anthropic/claude-sonnet-4
# MACROME_MODEL=

# ── Optional: email digests (also works in repo-root .env) ───────────────────
# Both RESEND_API_KEY and DIGEST_EMAIL are required to send mail.
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=you@example.com
# MACROME_EMAIL_FROM="MacroMe <digest@yourdomain.com>"

# ── Optional: Steel session lifetime ─────────────────────────────────────────
# Launch max is usually 15 minutes; set 60 only if your Steel plan allows it.
MACROME_SESSION_TIMEOUT_MINUTES=15

# ── Demo checkout (hackathon) ────────────────────────────────────────────────
# On by default: approving an order records it as placed (Today + digests
# update) without clicking Place Order, so no payment method is needed and
# DoorDash is never charged. Set to 0 for real checkout.
# MACROME_DEMO_PLACE=1

# ── Optional: demo / speed tuning (blank = code defaults) ────────────────────
MACROME_MAX_STORES=1
MACROME_SEARCH_BUDGET_SECONDS=120
MACROME_MAX_MENU_ITEMS=20
